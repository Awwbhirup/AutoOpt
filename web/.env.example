# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value here.

# Neon. Both come from the same place: your project's Connection Details panel.
# DATABASE_URL is the pooled one, host contains "-pooler".
# DIRECT_URL is the same string with "-pooler" removed. Migrations need it.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-me"

# GitHub OAuth app: Settings -> Developer settings -> OAuth Apps -> New.
# Homepage http://localhost:3000
# Callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Where the compute service is listening. `make serve` runs it on 8000.
AUTOOPT_SERVICE_URL="http://127.0.0.1:8000"
