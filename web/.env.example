# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value here.

# Neon: create a project at neon.tech, then Connection Details -> Prisma.
# Pooled connection for the app, direct for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-me"

# GitHub OAuth app: Settings -> Developer settings -> OAuth Apps -> New.
# Homepage http://localhost:3000
# Callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Where the compute service is listening. `make serve` runs it on 8000.
AUTOOPT_SERVICE_URL="http://127.0.0.1:8000"
