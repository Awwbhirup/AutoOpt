# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM providers -----------------------------------------------------------
# Gemini (primary):  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fallback, separate rate-limit bucket):  https://console.groq.com
GROQ_API_KEY=

# --- LLM behaviour -----------------------------------------------------------
# Provider: gemini | groq | stub
# "stub" returns canned responses so the pipeline runs with no network at all.
AUTOOPT_LLM_PROVIDER=gemini
AUTOOPT_LLM_MODEL=gemini-2.5-flash

# Responses are cached to disk keyed by prompt hash, so repeated experiment
# runs cost nothing and stay byte-identical. Delete the directory to re-query.
AUTOOPT_LLM_CACHE_DIR=.llm_cache

# --- Reproducibility ---------------------------------------------------------
# Seeds every RNG: corpus generation, differential-test inputs, SA, restarts.
AUTOOPT_SEED=20260904
